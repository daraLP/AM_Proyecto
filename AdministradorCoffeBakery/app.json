{
  "expo": {
    "name": "POSCafé",
    "slug": "poscafe",
    "scheme": "poscafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poscafe.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "POSCafé usa tu ubicación para mostrar los proveedores más cercanos.",
        "NSCameraUsageDescription": "POSCafé usa la cámara para tomar la foto de un insumo.",
        "NSPhotoLibraryUsageDescription": "POSCafé accede a tus fotos para asignar una imagen a un insumo."
      }
    },
    "android": {
      "package": "com.poscafe.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F9FA"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2ED573",
          "defaultChannel": "stock-alerts"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "POSCafé usa tu ubicación para mostrar los proveedores más cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "POSCafé accede a tus fotos para asignar una imagen a un insumo.",
          "cameraPermission": "POSCafé usa la cámara para tomar la foto de un insumo."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c3cc8901-8aac-4092-b755-8df5b3b808d3"
      }
    },
    "owner": "daralira"
  }
}
